# Copie este archivo como .env y ajuste los valores. NO suba .env al repositorio.
PORT=3000
APP_ENV=dev                  # dev | test | prod  (en dev los errores 500 incluyen "details")

# PostgreSQL (docker compose up -d lo publica en el puerto 5434 del equipo; Redis en el 6380)
DB_HOST=localhost
DB_PORT=5434
DB_USER=sigo
DB_PASSWORD=sigo_dev
DB_NAME=sigo_dental
DB_SSLMODE=disable
# En la nube (Neon/Render) se usa DATABASE_URL y tiene prioridad sobre DB_*:
# DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require

# JWT: mínimo 32 caracteres. Genere uno propio, p. ej. en PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio-de-desarrollo
SESSION_ABSOLUTE_HOURS=12

# Redis (caché Cache-Aside). Si no responde, la API funciona sin caché ("degraded").
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=

WEB_ORIGIN=http://localhost:5173
MFA_ISSUER=SIGO-Dental

# Zona horaria IANA de la clínica: define "hoy" en la agenda y la hora de los mensajes.
CLINIC_TIMEZONE=America/Guayaquil
CLINIC_NAME=Clínica Dental Demo (ficticia)

# Mensajería (RF-11). Sólo "simulated" está implementado: NO se envía nada real.
MESSAGING_PROVIDER=simulated
NOTIFICATIONS_DISPATCH_SECONDS=30

# Producción en un solo servidor: carpeta con la build del frontend (npm run build → dist)
# STATIC_DIR=../dist
