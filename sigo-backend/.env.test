# Configuración para `go test ./...` (pruebas de integración). Sin secretos reales.
# La base DEBE terminar en _test: las pruebas borran y recrean su esquema.
APP_ENV=test
DB_HOST=localhost
DB_PORT=5434
DB_USER=sigo
DB_PASSWORD=sigo_dev
DB_NAME=sigo_dental_test
DB_SSLMODE=disable
JWT_SECRET=secreto-de-pruebas-solo-para-go-test-0123456789
REDIS_ADDR=localhost:6380
# Base de Redis distinta a la de la aplicación (0): las pruebas no ensucian la caché de la app.
REDIS_DB=1
CLINIC_TIMEZONE=America/Guayaquil
CLINIC_NAME=Clínica Dental Demo (ficticia)
MESSAGING_PROVIDER=simulated
NOTIFICATIONS_DISPATCH_SECONDS=0
